        "swagger-ui-express": "^5.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "@types/swagger-ui-express": "^4.1.6",
        "nodemon": "^3.1.0",
        "tsx": "^4.7.2",
        "typescript": "^5.4.5"
    }
