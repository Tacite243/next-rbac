{
    "name": "example-express-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
