{
    "name": "@next-rbac/core",
    "version": "0.1.0",
    "description": "Ultra-performant, lightweight and framework-agnostic authorization engine",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "clean": "rm -rf dist node_modules"
    },
    "keywords": [
        "rbac",
        "abac",
        "authorization",
        "security",
        "permissions",
        "typescript",
        "nextjs"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "vitest": "^1.6.0"
    }
}