{
    "name": "@next-rbac/express",
    "version": "0.1.0",
    "description": "Express.js authorization middleware for next-rbac",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "prettier --check \"src/**/*.ts\"",
        "lint:fix": "prettier --write \"src/**/*.ts\"",
        "clean": "rm -rf dist node_modules"
    },
    "keywords": [
        "rbac",
        "abac",
        "express",
        "middleware",
        "authorization",
        "security"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "express": ">=4.0.0"
    },
    "dependencies": {
        "@next-rbac/core": "workspace:*"
    },
    "devDependencies": {
        "express": "^4.19.2",
        "@types/express": "^4.17.21"
    }
}